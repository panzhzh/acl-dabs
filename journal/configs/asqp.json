  "max_grad_norm": 1.0,
  "category_pos_weight_cap": 100.0,
  "category_pos_weight_mode": "balanced",
  "relation_positive_weight": 2.0,
  "pair_contrastive_loss_weight": 0.1,
  "dropout": 0.5,
  "num_workers": 2,
  "resume": true
